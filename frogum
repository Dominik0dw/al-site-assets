mount.innerHTML="<section id=\"al-frogum\" aria-labelledby=\"fg-heading\">\n  <div class=\"fg-intro\">\n    <span class=\"fg-eyebrow\">Příslušenství na míru · Frogum</span>\n    <h2 class=\"fg-title\" id=\"fg-heading\">Rohože a vany do kufru pro vaše auto.</h2>\n    <p class=\"fg-lead\">Vyberte vozidlo, porovnejte dostupná provedení a pokračujte do e-shopu podle objednacího kódu výrobku.</p>\n  </div>\n  <div class=\"fg-selector\" aria-label=\"Výběr vozidla\">\n    <div class=\"fg-selector-head\"><strong>Vyberte své vozidlo</strong><span class=\"fg-brand\">FROGUM</span></div>\n    <div class=\"fg-grid\">\n      <label><span class=\"fg-step\">1</span>Značka<select data-fg=\"make\" disabled><option>Načítání…</option></select></label>\n      <label><span class=\"fg-step\">2</span>Model<select data-fg=\"model\" disabled><option value=\"\">Nejprve vyberte značku</option></select></label>\n      <label><span class=\"fg-step\">3</span>Rok výroby<select data-fg=\"year\" disabled><option value=\"\">Nejprve vyberte model</option></select></label>\n      <label><span class=\"fg-step\">4</span>Generace<select data-fg=\"generation\" disabled><option value=\"\">Nejprve vyberte rok</option></select></label>\n    </div>\n    <div class=\"fg-selection-bar\">\n      <span class=\"fg-selection\" data-fg=\"selection\">Postupně zvolte značku, model a rok výroby.</span>\n      <div class=\"fg-actions\"><button type=\"button\" class=\"fg-text-button\" data-fg=\"reset\" disabled>Zrušit výběr</button><button type=\"button\" class=\"fg-text-button\" data-fg=\"share\" disabled>Sdílet výběr ↗</button></div>\n    </div>\n    <details class=\"fg-refine\" data-fg=\"refine\" hidden>\n      <summary>Upřesnit výběr</summary>\n      <div class=\"fg-grid\">\n        <label>Karoserie<select data-fg=\"body\"></select></label>\n        <label>Typ výrobku<select data-fg=\"type\"></select></label>\n        <label>Produktová řada<select data-fg=\"line\"></select></label>\n        <label>Barva<select data-fg