function normalizeProductCode(value){return String(value||'').replace(/\s+/g,'').toUpperCase();}
function productDetailFromDocument(doc,code,shopOrigin){
  var matches=new Set();
  doc.querySelectorAll('.flex-item[data-flex-group-id]').forEach(function(item){
    var brand=item.querySelector('.manufacturer-code .manufacturer');
    var number=item.querySelector('.manufacturer-code .code');
    var anchor=item.querySelector('.flex-header-container h2 a[href]');
    if(!brand||!number||!anchor)return;
    if(brand.textContent.trim().toLowerCase()!=='frogum')return;
    if(normalizeProductCode(number.textContent)!==normalizeProductCode(code))return;
    try{
      var url=new URL(anchor.getAttribute('href'),shopOrigin);
      if(url.origin!==shopOrigin||!/^https?:$/.test(url.protocol))return;
      if(!/\/\d+\/?$/.test(url.pathname))return;
      matches.add(url.href);
    }catch(e){}
  });
  return matches.size===1?Array.from(matches)[0]:null;
}
var resolvedProducts=new Map();
async function resolveProductDetail(code){
  var search=codeLink(code),origin='https://eshop.auto-lenc.cz';
  if(location.origin!==origin)return search;
  if(resolvedProducts.has(code))return resolvedProducts.get(code);
  var controller=new AbortController(),timer=setTimeout(function(){controller.abort();},10000);
  try{
    var response=await fetch(search,{credentials:'same-origin',signal:controller.signal});
    if(!response.ok||new URL(response.url||search).origin!==origin)return search;
    var doc=new DOMParser().parseFromString(await response.text(),'text/html');
    var detail=productDetailFromDocument(doc,code,origin);
    if(detail)resolvedProducts.set(code,detail);
    return detail||search;
  }catch(e){return search;}
  finally{clearTimeout(timer);}
}
function attachProductNavigation(){
  root.addEventListener('click',async function(event){
    var anchor=event.target.closest&&event.target.closest('a[data-fg-code]');
    if(!anchor||!root.contains(anchor)||event.defaultPrevented)return;
    if(event.button!==0||event.ctrlKey||event.metaKey||event.shiftKey||event.altKey)return;
    if(anchor.getAttribute('aria-busy')==='true'){event.preventDefault();return;}
    var code=anchor.getAttribute('data-fg-code');
    if(!code)return;
    event.preventDefault();
    var original=anchor.innerHTML;
    anchor.setAttribute('aria-busy','true');
    anchor.innerHTML='Otevíráme výrobek…';
    $('status').textContent='Vyhledáváme přesný výrobek v Auto Lenc…';
    try{
      var destination=await resolveProductDetail(code);
      window.location.assign(destination);
    }finally{
      anchor.removeAttribute('aria-busy');
      anchor.innerHTML=original;
    }
  });
}

