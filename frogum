  function filterResults(replace){limit=24;var query=$('search').value.trim().toLocaleLowerCase('cs');results=base.filter(function(p){return Object.keys(filters).every(function(key){return !$(key).value||has(p,filters[key],$(key).value);})&&(!query||[p.c,p.n,p.fit,p.note].concat(Object.keys(filters).flatMap(function(key){return labels(p,filters[key]);})).join(' ').toLocaleLowerCase('cs').includes(query));});render();writeHash(replace===true);}
